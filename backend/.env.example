# Sales Analyzer Backend — Environment Variables
# ================================================
# Copy this file to .env and customize as needed.
#   cp .env.example .env

# ── Security ─────────────────────────────────────────────
# Generate a real secret key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=super-secret-key-change-in-production
DEBUG=True

# ── Database ─────────────────────────────────────────────
# SQLite (default for local development — no server needed):
DATABASE_URL=sqlite:///./sales_analyzer.db

# MySQL (uncomment for production):
# DATABASE_URL=mysql+pymysql://user:password@localhost/sales_analyzer

# ── Model Paths ──────────────────────────────────────────
# DATA_PATH=../data
# MODEL_PATH=../model/saved/best

# ── Gemini API (for AI content generation) ───────────────
GEMINI_API_KEY=
