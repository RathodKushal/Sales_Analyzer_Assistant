  "epsilon_decay": 0.995,
  "batch_size": 64,
  "target_update_freq": 10,
  "buffer_capacity": 50000,
  "hidden_dims": [
    128,
    128,
    64
  ],
  "use_prioritized_replay": true,
  "save_dir": "model/saved",
  "checkpoint_freq": 25,
  "log_freq": 10
}